        "demand_forecasting": {
            "data_sparsity": "Extreme zero-inflation (99.98% zero sales across historical 200 days). While models learn low average demand accurately, point forecasts for sudden demand spikes in rare medicines have inherent uncertainty.",
            "horizon_decay": "Autoregressive multi-step forecasting compounds errors over longer horizons (> 14 days). Re-training or weekly batch refreshes are recommended.",
            "exogenous_factors": "The synthetic dataset lacks epidemiological disease outbreak feeds, seasonal epidemic indicators, or doctor prescription flow data that drive real-world pharmacy surges."
        },
        "expiry_risk_classification": {
            "synthetic_rule_proxy": "CRITICAL METHODOLOGY NOTE: The 'expiry_risk' ground-truth label was constructed via a deterministic heuristic rule (days_to_expiry <= 90 & unsold_ratio >= 0.30). High model accuracy reflects learning this heuristic surface, NOT predicting unobserved real-world clinical wastage.",
            "static_snapshots": "Batch inventory records are synthetic snapshots taken every 8 days. In live operations, real-time barcode scans and FIFO/FEFO dispense events provide continuous state updates.",
            "advisory_guardrail": "Outputs serve strictly as human decision support for pharmacy inventory managers and must never be used for autonomous disposal or clinical treatment substitution."
        }
